{
  "id": "firewall-plugin",
  "name": "Firewall Plugin",
  "description": "Passes OpenClaw prompt, tool-call, and persisted tool-result hook payloads to Silmaril for classification.",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "apiKey": { "type": "string" },
      "silmarilApiKey": { "type": "string" },
      "apiUrl": { "type": "string" },
      "timeoutMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 10000,
        "default": 2500
      }
    }
  },
  "uiHints": {
    "apiKey": { "label": "API Key", "sensitive": true },
    "silmarilApiKey": { "label": "Silmaril API Key", "sensitive": true },
    "apiUrl": { "label": "API URL" },
    "timeoutMs": { "label": "Classification timeout (ms)", "advanced": true }
  }
}
