# OpenClaw runtime configuration lives in ~/.openclaw/openclaw.json under:
# plugins.entries.firewall-plugin.config
#
# This environment value is only for the demo launcher's JSON status output.
# Do not commit real API keys.
OPENCLAW_FIREWALL_PLUGIN_CONFIG='{"apiUrl":"https://your-endpoint.execute-api.us-west-2.amazonaws.com/alpha/classify","silmarilApiKey":"replace-me"}'

# Optional public demo preview override.
SILMARIL_DEMO_BASE_URL=https://app.silmaril.dev
