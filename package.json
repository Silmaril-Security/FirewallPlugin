{
  "name": "@silmaril/firewall-plugin",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "manual:fp:webhook": "node scripts/manual-fp-webhook.mjs serve",
    "manual:fp:captures": "node scripts/manual-fp-webhook.mjs captures",
    "manual:fp:clear": "node scripts/manual-fp-webhook.mjs clear",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/*.test.ts\"",
    "test:e2e": "vitest run --config test/e2e/vitest.config.ts",
    "test:e2e:power-user": "vitest run --config test/e2e/vitest.config.ts test/e2e/scenarios"
  },
  "dependencies": {
    "@silmaril-security/sdk": "0.1.3"
  },
  "devDependencies": {
    "openclaw": "file:./test/shims/openclaw",
    "tsx": "^4.20.6",
    "undici": "^8.1.0",
    "vitest": "^4.1.4",
    "yaml": "^2.8.4"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  }
}
